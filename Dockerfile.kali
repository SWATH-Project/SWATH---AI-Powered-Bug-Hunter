FROM kalilinux/kali-rolling:latest

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies and Python tools
RUN apt-get update && apt-get install -y \
    # Core
    wget curl git jq \
    python3 python3-pip python3-venv python3-dev \
    build-essential libssl-dev libffi-dev \
    # Security tools from Kali repos
    nmap \
    ffuf \
    dirsearch \
    wpscan \
    gitleaks \
    trufflehog \
    sqlmap \
    nikto \
    whatweb \
    seclists \
    dirb \
    golang \
    pipx \
    nodejs \
    npm \
    libpcap-dev \
    && rm -rf /var/lib/apt/lists/*

# Install global NPM packages
RUN npm install -g wappalyzer

# Setup Go and local binary environment
ENV GOPATH=/go
ENV PATH=$PATH:/usr/local/go/bin:$GOPATH/bin:/home/swath/.local/bin

# Create non-root user
RUN useradd -m -s /bin/bash -u 1000 swath \
    && mkdir -p /go /home/swath/.swath /home/swath/output /home/swath/config \
    && chown -R swath:swath /go /home/swath

USER swath
WORKDIR /home/swath

# Install Go-based tools (these go to $GOPATH/bin which is in PATH)
# Note: continuing on error if a specific tool fails so the rest still install
RUN set -e; \
    for tool in \
        "github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest" \
        "github.com/owasp-amass/amass/v3/...@v3.18.3" \
        "github.com/tomnomnom/assetfinder@latest" \
        "github.com/projectdiscovery/httpx/cmd/httpx@latest" \
        "github.com/projectdiscovery/naabu/v2/cmd/naabu@latest" \
        "github.com/projectdiscovery/dnsx/cmd/dnsx@latest" \
        "github.com/projectdiscovery/katana/cmd/katana@latest" \
        "github.com/lc/gau/v2/cmd/gau@latest" \
        "github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest" \
        "github.com/hahwul/dalfox/v2@latest" \
        "github.com/jaeles-project/gospider@latest" \
        "github.com/haccer/subjack/v2/cmd/subjack@latest" \
    ; do \
        echo "Installing Go tool: $tool"; \
        if ! go install -v "$tool"; then \
            echo "WARNING: Failed to install $tool - continuing"; \
        fi; \
    done; \
    nuclei -update-templates 2>/dev/null || echo "WARNING: nuclei template update failed - run manually later"

# Install Python tools for the user
RUN pip3 install --user --break-system-packages --upgrade pip setuptools wheel 2>&1 | grep -v "WARNING" || true \
    && pip3 install --user --break-system-packages srcscan 2>/dev/null || true \
    && echo "Installing paramspider via pipx..." \
    && pipx install git+https://github.com/devanshbatham/paramspider.git || echo "WARNING: paramspider install failed - check manually"

# Verify installations
RUN echo "Verifying installed tools..." && \
    echo "Go binaries:" && ls -1 $(echo $GOPATH)/bin/ && \
    echo "" && \
    echo "Checking critical tools:" && \
    for tool in subfinder httpx naabu katana nuclei gau dalfox subjack; do \
        if command -v "$tool" >/dev/null 2>&1; then \
            echo "  [OK] $tool"; \
        else \
            echo "  [MISSING] $tool - will be skipped during scans"; \
        fi; \
    done && \
    echo "" && \
    echo "Checking Python tools:" && \
    python3 -c "import paramspider" 2>/dev/null && echo "  [OK] paramspider" || echo "  [MISSING] paramspider - install manually if needed"

# Copy SWATH project files
COPY --chown=swath:swath . /home/swath/

# Install Python dependencies in virtual environment
RUN python3 -m venv /home/swath/venv \
    && /home/swath/venv/bin/pip install --upgrade pip \
    && /home/swath/venv/bin/pip install -r requirements.txt

# Create convenience script
RUN echo '#!/bin/bash\nsource /home/swath/venv/bin/activate\nexec "$@"' > /home/swath/entrypoint.sh \
    && chmod +x /home/swath/entrypoint.sh

# Prepare directories
RUN mkdir -p /home/swath/logs /home/swath/output

ENTRYPOINT ["/home/swath/entrypoint.sh"]
CMD ["python3", "swath.py", "--help"]
